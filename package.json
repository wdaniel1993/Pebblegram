{
  "name": "Pebblegram AI",
  "author": "Daniel Wallner",
  "version": "1.0.29",
  "keywords": [
    "pebble-app"
  ],
  "scripts": {
    "build:pgjs-gramjs": "node tools/build-pgjs-gramjs.mjs"
  },
  "pebble": {
    "displayName": "Pebblegram AI",
    "uuid": "2430a9d0-5be9-4850-b259-821030705e46",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "diorite",
      "emery",
      "gabbro"
    ],
    "capabilities": [
      "configurable"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Command",
      "Type",
      "Index",
      "Count",
      "ChatId",
      "MessageId",
      "ReplyTo",
      "Sender",
      "Text",
      "IsOutgoing",
      "IsUnread",
      "UnreadCount",
      "BridgeUrl",
      "CannedReplies",
      "Status",
      "Error",
      "ImageToken",
      "ImageData",
      "ImageSize",
      "ImageTransferId",
      "ImageWidth",
      "ImageHeight",
      "Reactions",
      "EditMessageId",
      "ReplySender",
      "ReplyText",
      "ForwardSender",
      "ForwardText",
      "MessageMeta",
      "VoiceToken",
      "VoiceDuration",
      "VoiceSize",
      "VoiceSampleRate",
      "VoiceFormat",
      "VoiceData",
      "VoiceSeq",
      "VoiceTransferId",
      "VoiceDone",
      "VoiceError",
      "VoiceAction",
      "ThreadCount",
      "ThreadId",
      "ThreadList"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        }
      ]
    }
  },
  "devDependencies": {
    "@cryptography/aes": "0.1.1",
    "buffer": "6.0.3",
    "esbuild": "0.28.0",
    "jpeg-js": "0.4.4",
    "js-sha1": "0.7.0",
    "js-sha256": "0.11.1",
    "pako": "2.1.0",
    "teleproto": "1.228.5",
    "upng-js": "2.1.0"
  },
  "dependencies": {
    "mpg123-decoder": "^1.0.3",
    "opus-decoder": "^0.7.11"
  }
}
